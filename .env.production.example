# =============================================================================
# KikiiTick — Plantilla de entorno para producción/staging con Docker Compose
# =============================================================================
# Este archivo cubre el 100% de las variables de entorno REALMENTE ACTIVAS en
# este repositorio (auditado contra config/*.php + grep de app/ + resources/js),
# NO la lista completa de ~140 variables que Laravel expone por defecto en el
# esqueleto. Deliberadamente se omiten AWS_*, REDIS_*, MEMCACHED_*, SQS_*,
# PAPERTRAIL_*, SLACK_*, POSTMARK_*, RESEND_*: ninguno de esos drivers está
# activo hoy (DB_CONNECTION=mysql, CACHE_STORE=database, QUEUE_CONNECTION=
# database, SESSION_DRIVER=database, MAIL_MAILER=smtp son los únicos drivers
# realmente en uso) — agregarlas sin uso solo generaría ruido y una falsa
# sensación de "esto hay que configurarlo".
#
# Para desplegar: copiar este archivo a `.env` en la raíz del repo (mismo
# directorio que docker-compose.yml — compose lo lee automáticamente para
# sustituir las ${VAR} del compose) y completar cada valor marcado abajo.

# --- Núcleo de Laravel -------------------------------------------------------
APP_NAME=KikiiTick
APP_ENV=production
# ⚠️ OBLIGATORIO: generar con `php artisan key:generate --show` y pegar aquí
# ANTES del primer arranque — nunca reutilizar la clave de un entorno local/dev.
APP_KEY=
APP_DEBUG=false
APP_URL=https://kikiitick.com.mx
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Base de datos (servicio `mysql` del docker-compose.yml) ----------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kikiitick
DB_USERNAME=kikiitick_user
# ⚠️ OBLIGATORIO: contraseña real del usuario de la app.
DB_PASSWORD=
# ⚠️ OBLIGATORIO: contraseña de root de MySQL — DEBE ser distinta a DB_PASSWORD
# (solo la usa el contenedor `mysql` en su inicialización, Laravel nunca la lee).
DB_ROOT_PASSWORD=

# --- Sesión / Colas / Caché (drivers 'database', sin Redis) ------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# ⚠️ Debe ser `true` en producción real bajo HTTPS — pendiente conocido y
# documentado en claude.md de este mismo repo (Seguridad #5 de la auditoría).
# Ponerlo en `true` sin HTTPS real rompe la sesión por completo, así que solo
# se activa cuando APP_URL ya sirve sobre HTTPS de verdad (el `web` de este
# compose sirve HTTP plano en el puerto 80 — terminar TLS delante, ej. con un
# reverse proxy/balanceador externo, antes de encender esta bandera).
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=

QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Correo (servicio `mailpit` del docker-compose.yml) ----------------------
# ⚠️ Mailpit es un CAPTURADOR de correo para staging/pruebas — nunca entrega
# correo real a internet. Antes de recibir tráfico de clientes reales, cambiar
# estos 6 valores a un proveedor SMTP real (Mailtrap en plan de producción,
# SES, Postmark, etc.); de lo contrario ningún cliente recibirá jamás su
# confirmación de compra fuera de este entorno.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@kikiitick.com.mx"
MAIL_FROM_NAME="KikiiTick"

# --- Frontend / Sanctum -------------------------------------------------------
# Mismo origen que APP_URL: Nginx sirve la SPA Y proxea /api/* al mismo backend
# (ver docker/nginx/default.conf) — a propósito NO se define VITE_API_URL: el
# frontend cae a `window.location.origin` (bootstrap.js) y llama /api/* del
# mismo origen, sin CORS de por medio en este topología de un solo dominio.
FRONTEND_URL=https://kikiitick.com.mx
VITE_APP_NAME="${APP_NAME}"

# ⚠️ OBLIGATORIO: dominio(s) real(es) desde donde se sirve la SPA — sin esto,
# Sanctum rechaza la cookie de sesión como "no stateful" y el login nunca persiste.
SANCTUM_STATEFUL_DOMAINS=kikiitick.com.mx

# --- Mercado Pago (Módulo 5) --------------------------------------------------
# ⚠️ OBLIGATORIO: credenciales de PRODUCCIÓN (no las de sandbox usadas en
# desarrollo) — ver app/Services/MercadoPagoService.php y claude.md para el
# detalle de por qué notification_url/auto_return exigen que APP_URL sea
# pública y HTTPS real (no funcionan detrás de un túnel/localhost).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
